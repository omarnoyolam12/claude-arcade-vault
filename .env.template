# Copia este archivo a .env.local y rellena los valores.
# .env.local está ignorado por git; este .env.template sí se versiona.

# Clave de API de Resend. Obligatoria para enviar el correo del formulario
# de contacto de /acerca-de. Sin ella, la Server Action devuelve un error
# controlado y no envía nada.
RESEND_API_KEY=

# Remitente de los correos. Opcional: si se deja vacío se usa
# "onboarding@resend.dev" (dominio de pruebas de Resend). Para enviar a
# destinos arbitrarios hace falta un dominio propio verificado en Resend.
RESEND_FROM_EMAIL=

# Buzón del equipo que recibe las notificaciones del formulario de contacto.
CONTACT_TO_EMAIL=

# --- Supabase ---
# Backend de cuentas y puntuaciones. Las dos NEXT_PUBLIC_* se exponen al
# navegador; la SECRET nunca.

# URL del proyecto Supabase (https://<ref>.supabase.co). Expuesta al navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (sb_publishable_...). Segura en el cliente: respeta RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_...). Service role: se salta RLS. SOLO se documenta
# aquí; ningún archivo de la app la lee todavía. Reservada para operaciones
# administrativas de una spec futura. Nunca la expongas al navegador.
SUPABASE_SECRET_KEY=

# Ref del proyecto Supabase (el "<ref>" de https://<ref>.supabase.co). Solo lo
# usa el script `npm run gen:types` vía `supabase link` para regenerar
# lib/supabase/database.types.ts. La app NO lo lee en runtime.
SUPABASE_PROJECT_REF=
